<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:MathGuide.Models"
             xmlns:vm="clr-namespace:MathGuide.ViewModels"
             x:Class="MathGuide.Pages.RulesListPage"
             x:Name="PageRoot"
             x:DataType="vm:RulesListViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="20,18,20,12" Spacing="4">
            <Label Text="{Binding Subject, StringFormat='Правила: {0}'}"
                   Style="{StaticResource H1}" />
            <Label Text="{Binding Rules.Count, StringFormat='{0} правил · нажми, чтобы открыть PDF'}"
                   Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Rules}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem"
                        Margin="20,8,20,24">
            <CollectionView.EmptyView>
                <Label Text="Правила пока не добавлены."
                       Style="{StaticResource Caption}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:MathRule">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenPdfCommand}"
                                CommandParameter="{Binding PdfFileName}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Title}"
                                   Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding Description}"
                                   Style="{StaticResource Caption}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="Открыть PDF →"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
