<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:MathGuide.Models"
             x:Class="MathGuide.Pages.CalculatorPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- ───── Шапка ───── -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="12" Padding="20,14,20,10">
            <Border Style="{StaticResource HeaderIconChip}">
                <ImageButton Source="menu.png" HeightRequest="18" WidthRequest="18"
                             BackgroundColor="Transparent" />
            </Border>
            <Border Grid.Column="2" Style="{StaticResource HeaderIconChip}">
                <Grid>
                    <ImageButton Source="bell.png" HeightRequest="18" WidthRequest="18"
                                 BackgroundColor="Transparent" />
                    <Ellipse Fill="{StaticResource Accent}" WidthRequest="8" HeightRequest="8"
                             HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,4,0" />
                </Grid>
            </Border>
            <Border Grid.Column="3" WidthRequest="38" HeightRequest="38"
                    StrokeThickness="0" Padding="0" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="19" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#16162B" Offset="0,3" Radius="8" Opacity="0.10" />
                </Border.Shadow>
                <Image Source="avatar.png" Aspect="AspectFill" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,28" Spacing="22">

                <Label FontSize="13.5" LineHeight="1.4" TextColor="{StaticResource TextSecondary}"
                       Text="Напиши задачу или сфотографируй её — калькулятор покажет ответ и разбор по шагам." />

                <!-- Поле ввода с камерой -->
                <Border Style="{StaticResource QuestionField}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="QuestionEntry" Placeholder="Например: 5x − 8 = 2x + 4"
                               ReturnType="Send" Completed="OnSolveText" VerticalOptions="Center" />
                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34" Padding="0"
                                BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17" />
                            </Border.StrokeShape>
                            <ImageButton Source="camera.png" WidthRequest="17" HeightRequest="17"
                                         BackgroundColor="Transparent" Clicked="OnTakePhoto" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Две главные кнопки -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource PrimaryButton}">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="camera_white.png" WidthRequest="18" HeightRequest="18" />
                            <Label Text="Сфотографировать" FontSize="13.5" FontAttributes="Bold"
                                   TextColor="{StaticResource TextOnPrimary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTakePhoto" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SecondaryButton}">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="gallery.png" WidthRequest="18" HeightRequest="18" />
                            <Label Text="Из галереи" FontSize="13.5" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickPhoto" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Предпросмотр снимка -->
                <Border x:Name="PreviewCard" Style="{StaticResource Card}" IsVisible="False" Padding="8">
                    <Image x:Name="PreviewImage" Aspect="AspectFit" HeightRequest="180" />
                </Border>

                <!-- Индикатор -->
                <ActivityIndicator x:Name="Busy" IsVisible="False" IsRunning="False"
                                   Color="{StaticResource Primary}" />

                <!-- Результат -->
                <Border x:Name="ResultCard" Style="{StaticResource Card}" IsVisible="False" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="RecognizedLabel" Style="{StaticResource Caption}" />
                        <Label x:Name="AnswerLabel" FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <BoxView HeightRequest="1" Color="{StaticResource Stroke}" />
                        <VerticalStackLayout x:Name="StepsStack" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

                <!-- Быстрый выбор раздела -->
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionTitle}" Text="Разделы" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="12" RowSpacing="12">
                        <Border Style="{StaticResource Tile}" HeightRequest="56" Padding="14,0"
                                Background="{StaticResource GradIndigo}">
                            <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
                                <Image Source="book_white.png" WidthRequest="16" HeightRequest="16" Opacity="0.9" />
                                <Label Text="Уравнения" FontSize="14" FontAttributes="Bold"
                                       TextColor="White" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Tile}" HeightRequest="56" Padding="14,0"
                                Background="{StaticResource GradFire}">
                            <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
                                <Image Source="book_white.png" WidthRequest="16" HeightRequest="16" Opacity="0.9" />
                                <Label Text="Дроби" FontSize="14" FontAttributes="Bold"
                                       TextColor="White" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Tile}" HeightRequest="56" Padding="14,0"
                                Background="{StaticResource GradMagenta}">
                            <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
                                <Image Source="book_white.png" WidthRequest="16" HeightRequest="16" Opacity="0.9" />
                                <Label Text="Геометрия" FontSize="14" FontAttributes="Bold"
                                       TextColor="White" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}" HeightRequest="56" Padding="14,0"
                                Background="{StaticResource GradGold}">
                            <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
                                <Image Source="book_white.png" WidthRequest="16" HeightRequest="16" Opacity="0.9" />
                                <Label Text="Проценты" FontSize="14" FontAttributes="Bold"
                                       TextColor="White" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Частые вопросы -->
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource SectionTitle}" Text="Частые вопросы" />

                    <VerticalStackLayout Spacing="8"
                                         BindableLayout.ItemsSource="{Binding Faq}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:FaqItem">
                                <Border Style="{StaticResource Card}" Padding="14,13">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Question}" FontSize="13"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center" />
                                        <Image Grid.Column="1" Source="chevron.png"
                                               WidthRequest="14" HeightRequest="14"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
