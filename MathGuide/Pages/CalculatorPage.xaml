<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:MathGuide.Models"
             x:Class="MathGuide.Pages.CalculatorPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- ───── Шапка ───── -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="14" Padding="20,14,20,10">
            <ImageButton Source="menu.png" HeightRequest="22" WidthRequest="22"
                         BackgroundColor="Transparent" VerticalOptions="Center" />
            <ImageButton Grid.Column="2" Source="bell.png" HeightRequest="22" WidthRequest="22"
                         BackgroundColor="Transparent" VerticalOptions="Center" />
            <Border Grid.Column="3" WidthRequest="36" HeightRequest="36"
                    StrokeThickness="0" Padding="0" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Image Source="avatar.png" Aspect="AspectFill" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,28" Spacing="22">

                <Label FontSize="13.5" LineHeight="1.4" TextColor="{StaticResource TextSecondary}"
                       Text="Напиши задачу или сфотографируй её — калькулятор покажет ответ и разбор по шагам." />

                <!-- Поле ввода с камерой -->
                <Border Style="{StaticResource QuestionField}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="QuestionEntry" Placeholder="Например: 5x − 8 = 2x + 4"
                               ReturnType="Send" Completed="OnSolveText" />
                        <ImageButton Grid.Column="1" Source="camera.png"
                                     WidthRequest="24" HeightRequest="24" Padding="8"
                                     BackgroundColor="Transparent" Clicked="OnTakePhoto" />
                    </Grid>
                </Border>

                <!-- Две главные кнопки -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Background="{StaticResource GradIndigo}" StrokeThickness="0" Padding="0"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13" />
                        </Border.StrokeShape>
                        <Label Text="Сфотографировать" FontSize="13.5" FontAttributes="Bold"
                               TextColor="{StaticResource TextOnPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTakePhoto" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Stroke}" StrokeThickness="1"
                            Padding="0" HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13" />
                        </Border.StrokeShape>
                        <Label Text="Выбрать из галереи" FontSize="13.5" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickPhoto" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Предпросмотр снимка -->
                <Border x:Name="PreviewCard" Style="{StaticResource Card}" IsVisible="False" Padding="8">
                    <Image x:Name="PreviewImage" Aspect="AspectFit" HeightRequest="180" />
                </Border>

                <!-- Индикатор -->
                <ActivityIndicator x:Name="Busy" IsVisible="False" IsRunning="False"
                                   Color="{StaticResource Primary}" />

                <!-- Результат -->
                <Border x:Name="ResultCard" Style="{StaticResource Card}" IsVisible="False" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="RecognizedLabel" Style="{StaticResource Caption}" />
                        <Label x:Name="AnswerLabel" FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <BoxView HeightRequest="1" Color="{StaticResource Stroke}" />
                        <VerticalStackLayout x:Name="StepsStack" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

                <!-- Быстрый выбор раздела -->
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionTitle}" Text="Разделы" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="12" RowSpacing="12">
                        <Border Style="{StaticResource Tile}" HeightRequest="56"
                                Background="{StaticResource GradIndigo}">
                            <Label Text="Уравнения" FontSize="14" FontAttributes="Bold"
                                   TextColor="White" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Tile}" HeightRequest="56"
                                Background="{StaticResource GradFire}">
                            <Label Text="Дроби" FontSize="14" FontAttributes="Bold"
                                   TextColor="White" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Tile}" HeightRequest="56"
                                Background="{StaticResource GradMagenta}">
                            <Label Text="Геометрия" FontSize="14" FontAttributes="Bold"
                                   TextColor="White" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}" HeightRequest="56"
                                Background="{StaticResource GradGold}">
                            <Label Text="Проценты" FontSize="14" FontAttributes="Bold"
                                   TextColor="White" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Частые вопросы -->
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource SectionTitle}" Text="Частые вопросы" />

                    <VerticalStackLayout Spacing="8"
                                         BindableLayout.ItemsSource="{Binding Faq}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:FaqItem">
                                <Border Style="{StaticResource Card}" Padding="14,13">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Question}" FontSize="13"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center" />
                                        <Image Grid.Column="1" Source="chevron.png"
                                               WidthRequest="14" HeightRequest="14"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
