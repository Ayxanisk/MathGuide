<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:MathGuide.Models"
             xmlns:vm="clr-namespace:MathGuide.ViewModels"
             x:Class="MathGuide.Pages.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- ───── Шапка ───── -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="12" Padding="20,14,20,10">

            <Border Style="{StaticResource HeaderIconChip}">
                <ImageButton Source="menu.png" HeightRequest="18" WidthRequest="18"
                             BackgroundColor="Transparent" />
            </Border>

            <Border Grid.Column="2" Style="{StaticResource HeaderIconChip}">
                <Grid>
                    <ImageButton Source="bell.png" HeightRequest="18" WidthRequest="18"
                                 BackgroundColor="Transparent" />
                    <Ellipse Fill="{StaticResource Accent}" WidthRequest="8" HeightRequest="8"
                             HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,4,0" />
                </Grid>
            </Border>

            <Border Grid.Column="3" WidthRequest="38" HeightRequest="38"
                    StrokeThickness="0" Padding="0" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="19" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#16162B" Offset="0,3" Radius="8" Opacity="0.10" />
                </Border.Shadow>
                <Image Source="avatar.png" Aspect="AspectFill" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- ───── Содержимое ───── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,28" Spacing="24">

                <!-- Приветствие -->
                <VerticalStackLayout Spacing="3">
                    <Label Style="{StaticResource H1}" Text="{Binding UserName, StringFormat='Привет, {0}!'}" />
                    <HorizontalStackLayout Spacing="4">
                        <Label Style="{StaticResource Caption}" FontSize="13" Text="На этой неделе добавлено" />
                        <Label FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Accent}"
                               Text="{Binding NewTopicsCount, StringFormat='{0} новых тем'}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Карточка баллов -->
                <Border StrokeThickness="0"
                        Background="{StaticResource GradIndigo}" Padding="20,18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource RadiusXL}" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#4F5BD5" Offset="0,10" Radius="20" Opacity="0.28" />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding Points}" FontSize="36" FontAttributes="Bold"
                                   TextColor="{StaticResource TextOnPrimary}" />
                            <Label Text="баллов" FontSize="13" VerticalOptions="End" Margin="0,0,0,8"
                                   TextColor="{StaticResource TextOnPrimaryMuted}" />
                        </HorizontalStackLayout>

                        <Border Grid.Column="1" Style="{StaticResource BadgePill}" VerticalOptions="Start">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="Решать" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Style="{StaticResource ArrowGlyph}" TextColor="{StaticResource Primary}" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSolveTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Label Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" LineHeight="1.35"
                               TextColor="{StaticResource TextOnPrimaryMuted}"
                               Text="{Binding WeeklyGoal, StringFormat='Набери {0} баллов за неделю — откроется разбор задач с репетитором'}" />
                    </Grid>
                </Border>

                <!-- Продолжить изучение -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource SectionTitle}" Text="Продолжить изучение" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                                   Text="Все темы" VerticalOptions="Center" />
                            <Label Style="{StaticResource ArrowGlyph}" FontSize="12"
                                   TextColor="{StaticResource Primary}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween"
                                BindableLayout.ItemsSource="{Binding ContinueList}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:RuleCard">
                                <Border Style="{StaticResource Card}" FlexLayout.Basis="48%" Margin="0,0,0,12">
                                    <VerticalStackLayout Spacing="9">
                                        <Label Text="{Binding Title}" FontSize="13.5" FontAttributes="Bold"
                                               LineHeight="1.25" MaxLines="2" LineBreakMode="TailTruncation"
                                               TextColor="{StaticResource TextPrimary}" />

                                        <Border Style="{StaticResource Chip}">
                                            <Label Text="{Binding Section}" FontSize="10.5" FontAttributes="Bold"
                                                   TextColor="{Binding SectionColor}" />
                                        </Border>

                                        <ProgressBar Progress="{Binding Progress}"
                                                     ProgressColor="{StaticResource Primary}"
                                                     BackgroundColor="{StaticResource SurfaceMuted}" />

                                        <HorizontalStackLayout Spacing="5">
                                            <Image Source="clock.png" WidthRequest="12" HeightRequest="12"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding Meta}" Style="{StaticResource Caption}"
                                                   FontSize="10.5" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Разделы -->
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionTitle}" Text="Разделы" />

                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween"
                                BindableLayout.ItemsSource="{Binding Sections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:SectionChip">
                                <Border Style="{StaticResource Tile}" Background="{Binding Background}"
                                        FlexLayout.Basis="48%" Margin="0,0,0,12" HeightRequest="66"
                                        Padding="14,0">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Image Source="book_white.png" WidthRequest="18" HeightRequest="18"
                                               Opacity="0.9" />
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource TextOnPrimary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Классы 1–11 -->
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionTitle}" Text="Класс" />

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="9" Padding="0,2,0,6"
                                               BindableLayout.ItemsSource="{Binding Grades}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:GradeItem">
                                    <Border WidthRequest="46" HeightRequest="46" Padding="0"
                                            StrokeThickness="1" Stroke="{StaticResource Stroke}"
                                            BackgroundColor="{Binding Background}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="23" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#16162B" Offset="0,3" Radius="8" Opacity="0.06" />
                                        </Border.Shadow>
                                        <Label Text="{Binding Label}" FontSize="15" FontAttributes="Bold"
                                               TextColor="{Binding TextColor}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
