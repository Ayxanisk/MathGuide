<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MathGuide.Pages.LoginPage"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- Закрыть -->
        <Grid Grid.Row="0" Padding="20,16,20,0">
            <Border Style="{StaticResource HeaderIconChip}" HorizontalOptions="Start">
                <Label Text="✕" FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,8,24,32" Spacing="26">

                <!-- Баннер -->
                <Border StrokeThickness="0" Background="{StaticResource GradIndigo}"
                        Padding="24,0" HeightRequest="150">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource RadiusXL}" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#4F5BD5" Offset="0,10" Radius="20" Opacity="0.25" />
                    </Border.Shadow>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                        <Label Text="С возвращением!" FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource TextOnPrimary}" />
                        <Label Text="Войди, чтобы сохранять прогресс и баллы"
                               FontSize="13" TextColor="{StaticResource TextOnPrimaryMuted}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Форма -->
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email или телефон" FontSize="12.5" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border Style="{StaticResource FormField}">
                            <Entry x:Name="LoginEntry" Placeholder="you@example.com"
                                   Keyboard="Email" VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Пароль" FontSize="12.5" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border Style="{StaticResource FormField}">
                            <Entry x:Name="PasswordEntry" Placeholder="••••••••"
                                   IsPassword="True" VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="Забыл пароль?" FontSize="12.5" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Кнопки -->
                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource PrimaryButton}">
                        <Label Text="Войти" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextOnPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoginTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource SecondaryButton}">
                        <Label Text="Продолжить как гость" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGuestTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>

                <!-- Ссылка на регистрацию -->
                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="Нет аккаунта?" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="Зарегистрироваться" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToRegisterTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
